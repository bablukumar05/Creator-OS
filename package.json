{
  "name": "creator-os",
  "version": "1.0.0",
  "author": "CreatorOS Core Engineering Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "config:check": "node server/scripts/check-config.js",
    "db:check": "node server/scripts/check-config.js --connect",
    "data:check": "node server/scripts/verify-data.js",
    "preview": "npm run preview -w client",
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "demo": "cross-env DEMO_MODE=true npm run dev",
    "client": "npm run dev -w client",
    "server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "seed:reset": "npm run seed:reset -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "admin:create": "node server/seed/create-admin.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
